{
  "$schema": "https://raw.githubusercontent.com/EmmyLuaLs/emmylua-analyzer-rust/refs/heads/main/crates/emmylua_code_analysis/resources/schema.json",
  "runtime": {
    "version": "LuaJIT",
    "requirePattern": [
      "lua/?.lua",
      "lua/?/init.lua"
    ]
  },
  "diagnostics": {
    "enable": true,
    "disable": [
      "unnecessary-if",
      "await-in-sync",
      "global-in-non-module"
    ]
  },
  "workspace": {
    "library": [
      "$VIMRUNTIME",
      "$XDG_DATA_HOME/nvim/site/pack/core/opt/blink.cmp",
      "$XDG_DATA_HOME/nvim/site/pack/core/opt/codediff.nvim",
      "$XDG_DATA_HOME/nvim/site/pack/core/opt/conform.nvim",
      "$XDG_DATA_HOME/nvim/site/pack/core/opt/diffview.nvim",
      "$XDG_DATA_HOME/nvim/site/pack/core/opt/fidget.nvim",
      "$XDG_DATA_HOME/nvim/site/pack/core/opt/lz.n",
      "$XDG_DATA_HOME/nvim/site/pack/core/opt/mason-lspconfig.nvim",
      "$XDG_DATA_HOME/nvim/site/pack/core/opt/mason.nvim",
      "$XDG_DATA_HOME/nvim/site/pack/core/opt/mini.nvim",
      "$XDG_DATA_HOME/nvim/site/pack/core/opt/nvim-dap",
      "$XDG_DATA_HOME/nvim/site/pack/core/opt/nvim-jdtls",
      "$XDG_DATA_HOME/nvim/site/pack/core/opt/nvim-lspconfig",
      "$XDG_DATA_HOME/nvim/site/pack/core/opt/nvim-treesitter",
      "$XDG_DATA_HOME/nvim/site/pack/core/opt/nvim-treesitter-context",
      "$XDG_DATA_HOME/nvim/site/pack/core/opt/nvim-treesitter-textobjects",
      "$XDG_DATA_HOME/nvim/site/pack/core/opt/nvim-web-devicons",
      "$XDG_DATA_HOME/nvim/site/pack/core/opt/oil.nvim",
      "$XDG_DATA_HOME/nvim/site/pack/core/opt/one-small-step-for-vimkind",
      "$XDG_DATA_HOME/nvim/site/pack/core/opt/quicker.nvim",
      "$XDG_DATA_HOME/nvim/site/pack/core/opt/render-markdown.nvim",
      "$XDG_DATA_HOME/nvim/site/pack/core/opt/snacks.nvim",
      "$XDG_DATA_HOME/nvim/site/pack/core/opt/ts-vimdoc.nvim",
      "$XDG_DATA_HOME/nvim/site/pack/core/opt/gitsigns.nvim",
      "$HOME/Sources/nvim/fzf-lua"
    ],
    "preloadFileSize": 1000
  },
  "hint": {
    "enable": true
  }
}